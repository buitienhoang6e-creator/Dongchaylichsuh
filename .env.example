# Sao chép file này thành ".env" rồi điền giá trị thật.
# KHÔNG đưa file .env lên GitHub (đã được chặn trong .gitignore).

# ───────────── Giảng viên AI ─────────────
# Chọn nhà cung cấp: "groq" (miễn phí) hoặc "claude" (trả phí, chất lượng cao hơn).
# Bỏ trống thì tự chọn theo khóa có sẵn (ưu tiên Groq).
AI_PROVIDER=

# Khóa API của Groq (MIỄN PHÍ) — tạo tại https://console.groq.com/keys
# Người tạo tài khoản Groq phải từ 18 tuổi trở lên.
GROQ_API_KEY=

# Model của Groq. Qua thử nghiệm, qwen3.8-27b trả lời đúng tư liệu nhất.
GROQ_MODEL=qwen/qwen3.8-27b

# Model dự phòng khi model chính hết lượt miễn phí (mỗi model có hạn mức riêng). Mặc định để trống:
# hết lượt thì học sinh được nhắn đợi khoảng một phút. Có thể bật thêm, ví dụ
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# nhưng khi thử nghiệm, các model gpt-oss hay bịa chi tiết lịch sử hơn qwen.
GROQ_FALLBACK_MODELS=

# (Tùy chọn) Mức "suy nghĩ" trước khi trả lời: low | medium | high. Bỏ trống = mặc định
# (qwen không suy nghĩ để trả lời nhanh; gpt-oss suy nghĩ mức vừa).
GROQ_REASONING_EFFORT=

# (Tùy chọn) Độ "ngẫu nhiên" của câu trả lời, từ 0 đến 2. Bỏ trống = 0.1 (bám sát tư liệu, ít bịa).
GROQ_TEMPERATURE=

# (Tùy chọn) Khóa API của Anthropic để dùng Claude — trả phí, lấy tại https://platform.claude.com (mục API Keys).
ANTHROPIC_API_KEY=
# Model Claude: claude-opus-5-5 (chất lượng cao nhất) hoặc claude-haiku-5-5 (rẻ hơn rất nhiều).
CLAUDE_MODEL=claude-opus-5-5

# Cổng chạy server khi chạy trên máy. Hostinger tự đặt biến PORT, không cần sửa.
PORT=3000

# ───────────── Tài khoản người học ─────────────
# Thư mục chứa cơ sở dữ liệu tài khoản và tiến độ học (file dong-chay-lich-su.db).
# Bỏ trống = thư mục "data" trong dự án; riêng trên Hostinger (ứng dụng Node.js trong hPanel) tự dùng
# ~/dong-chay-lich-su-data để không bị xóa khi triển khai lại. Trên VPS nên đặt ở thư mục ngoài mã nguồn,
# ví dụ DATA_DIR=/home/ten-tai-khoan/dong-chay-data — và nhớ sao lưu file .db định kỳ.
DATA_DIR=

# (Tùy chọn) Lưu tài khoản trên Turso (cơ sở dữ liệu trên mạng, có gói miễn phí) thay vì file trong DATA_DIR.
# Cần khi đặt web ở nơi không giữ được file, ví dụ Render miễn phí. Lấy hai giá trị này trong trang quản lý Turso:
# địa chỉ dạng libsql://ten-csdl-ten-ban.turso.io và mã truy cập (Create Token). Có TURSO_DATABASE_URL thì DATA_DIR bị bỏ qua.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
